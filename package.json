{
  "name": "agentable",
  "version": "0.1.0",
  "description": "Put your app in any AI by registering actions directly in React components.",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vibeflowing-inc/agentable.git"
  },
  "homepage": "https://github.com/vibeflowing-inc/agentable",
  "bugs": {
    "url": "https://github.com/vibeflowing-inc/agentable/issues"
  },
  "packageManager": "pnpm@10.6.2",
  "workspaces": [
    "packages/*",
    "examples/*"
  ],
  "scripts": {
    "build": "pnpm -r --filter \"./packages/*\" build",
    "dev": "pnpm -r --parallel --filter \"./packages/*\" dev",
    "clean": "pnpm -r --filter \"./packages/*\" run clean",
    "verify-dist": "pnpm -r --filter \"./packages/*\" exec node ../../scripts/verify-dist.mjs",
    "release": "pnpm clean && pnpm build && pnpm verify-dist && pnpm -r --filter \"./packages/*\" publish --access public --no-git-checks"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild"]
  }
}
