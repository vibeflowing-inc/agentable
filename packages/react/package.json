{
  "name": "@vibeflowai/agentable-react",
  "version": "0.1.1",
  "description": "React provider and hooks to register and execute Agentable actions.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/saquand/agentable.git",
    "directory": "packages/react"
  },
  "homepage": "https://github.com/saquand/agentable#readme",
  "bugs": {
    "url": "https://github.com/saquand/agentable/issues"
  },
  "keywords": ["agentable", "react", "ai", "tool-calling", "hooks"],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": ["dist"],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean --external react --external react-dom --external @vibeflowai/agentable-core",
    "dev": "tsup src/index.ts --format esm,cjs --dts --watch --external react --external react-dom --external @vibeflowai/agentable-core"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0",
    "@vibeflowai/agentable-core": "^0.1.1",
    "zod": ">=3.0.0"
  },
  "devDependencies": {
    "@vibeflowai/agentable-core": "workspace:*",
    "@types/react": "^18.0.0",
    "@types/react-dom": "^18.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.0.0",
    "zod": "^3.22.0",
    "react": "^18.0.0",
    "react-dom": "^18.0.0"
  }
}
