{
  "name": "@vibeflowai/agentable-core",
  "version": "0.1.4",
  "description": "Framework-agnostic action registry and dispatcher for Agentable.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vibeflowing-inc/agentable.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/vibeflowing-inc/agentable#readme",
  "bugs": {
    "url": "https://github.com/vibeflowing-inc/agentable/issues"
  },
  "keywords": [
    "agentable",
    "ai",
    "tool-calling",
    "actions",
    "zod"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "scripts": {
    "clean": "rimraf dist",
    "build": "tsup src/index.ts --format esm,cjs --dts --clean",
    "dev": "tsup src/index.ts --format esm,cjs --dts --watch",
    "prepublishOnly": "pnpm run clean && pnpm run build && node ../../scripts/verify-dist.mjs"
  },
  "peerDependencies": {
    "zod": ">=3.0.0"
  },
  "dependencies": {
    "zod-to-json-schema": "^3.23.0"
  },
  "devDependencies": {
    "rimraf": "^6.0.1",
    "tsup": "^8.0.0",
    "typescript": "^5.0.0",
    "zod": "^3.22.0"
  }
}
