{
  "name": "@vibeflowai/agentable-server",
  "version": "0.1.4",
  "description": "HTTP bridge for Agentable with Express and Next.js adapters.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vibeflowing-inc/agentable.git",
    "directory": "packages/server"
  },
  "homepage": "https://github.com/vibeflowing-inc/agentable#readme",
  "bugs": {
    "url": "https://github.com/vibeflowing-inc/agentable/issues"
  },
  "keywords": ["agentable", "server", "express", "nextjs", "ai"],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": ["dist"],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./adapters/express": {
      "types": "./dist/adapters/express.d.ts",
      "import": "./dist/adapters/express.js",
      "require": "./dist/adapters/express.cjs"
    },
    "./adapters/nextjs": {
      "types": "./dist/adapters/nextjs.d.ts",
      "import": "./dist/adapters/nextjs.js",
      "require": "./dist/adapters/nextjs.cjs"
    }
  },
  "scripts": {
    "clean": "rimraf dist",
    "build": "tsup src/index.ts src/adapters/express.ts src/adapters/nextjs.ts --format esm,cjs --dts --clean",
    "dev": "tsup src/index.ts src/adapters/express.ts src/adapters/nextjs.ts --format esm,cjs --dts --watch",
    "prepublishOnly": "pnpm run clean && pnpm run build && node ../../scripts/verify-dist.mjs"
  },
  "dependencies": {
    "@vibeflowai/agentable-core": "workspace:^"
  },
  "devDependencies": {
    "rimraf": "^6.0.1",
    "tsup": "^8.0.0",
    "typescript": "^5.0.0",
    "@types/express": "^4.17.0"
  }
}
