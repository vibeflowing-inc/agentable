{
  "name": "@agentable/adapter-vercel-ai",
  "version": "0.1.0",
  "description": "Vercel AI SDK adapter that exposes discoverActions and callAction.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/saquand/agentable.git",
    "directory": "packages/adapter-vercel-ai"
  },
  "homepage": "https://github.com/saquand/agentable#readme",
  "bugs": {
    "url": "https://github.com/saquand/agentable/issues"
  },
  "keywords": ["agentable", "vercel-ai-sdk", "ai", "tool-calling", "adapter"],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": ["dist"],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean",
    "dev": "tsup src/index.ts --format esm,cjs --dts --watch"
  },
  "peerDependencies": {
    "ai": ">=4.0.0",
    "@agentable/server": "^0.1.0",
    "zod": ">=3.0.0"
  },
  "devDependencies": {
    "tsup": "^8.0.0",
    "typescript": "^5.0.0",
    "ai": "^4.0.0",
    "@agentable/server": "workspace:*",
    "zod": "^3.22.0"
  }
}
